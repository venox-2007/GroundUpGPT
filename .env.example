# GroundUpGPT Local Inference Server Configuration

# Host and port binding (default: localhost 127.0.0.1:8000)
GROUNDUPGPT_HOST=127.0.0.1
GROUNDUPGPT_PORT=8000

# Artifact paths (relative to repository root or absolute)
GROUNDUPGPT_CHECKPOINT_PATH=checkpoints/demo_checkpoint.pt
GROUNDUPGPT_TOKENIZER_PATH=checkpoints/demo_tokenizer.json

# Permitted CORS origins for local frontend development (JSON list format)
GROUNDUPGPT_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Generation constraints & safety boundaries
GROUNDUPGPT_MAX_PROMPT_CHARS=2048
GROUNDUPGPT_MAX_NEW_TOKENS=512

# Compute device ('auto', 'cuda', or 'cpu')
GROUNDUPGPT_DEVICE=auto
